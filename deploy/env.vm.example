# =========================================================
# File .env mẫu cho triển khai lên VM (VPS Ubuntu)
# Copy file này ra thư mục gốc repo: cp deploy/.env.vm.example .env
# Sau đó điền đầy đủ giá trị thật của bạn trước khi chạy setup_vm.sh
# =========================================================

# Django Core
DEBUG=False
# Tạo secret key ngẫu nhiên bằng lệnh:
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=thay-bang-chuoi-bi-mat-ngau-nhien-dai-50-ky-tu

# Thay <IP_CUA_VM> bằng IP public của VPS bạn
ALLOWED_HOSTS=localhost,127.0.0.1,finacialflow.duckdns.org,<IP_CUA_VM>
CSRF_TRUSTED_ORIGINS=https://finacialflow.duckdns.org
CORS_ALLOWED_ORIGINS=https://finacialflow.duckdns.org
FRONTEND_URL=https://finacialflow.duckdns.org

# Cookie Security (giữ True khi chạy HTTPS với Certbot; chỉ tạm đổi False nếu test HTTP qua IP)
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Database (Dùng Neon DB hiện tại HOẶC Postgres local/Docker trên VM)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Gmail SMTP (gửi mail xác thực & quên mật khẩu)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your_google_app_password
DEFAULT_FROM_EMAIL=your@gmail.com

# AI Assistant (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_AI_MODEL=gemini-2.5-flash

# Google Login OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
