[Unit]
Description=FinanceFlow Django Gunicorn Daemon
After=network.target

[Service]
User=__APP_USER__
Group=www-data
WorkingDirectory=__APP_DIR__/backend
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/backend/venv/bin/gunicorn \
    --access-logfile - \
    --error-logfile - \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
