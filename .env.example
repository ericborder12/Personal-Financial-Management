POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
SECRET_KEY=your_secret_key
DEBUG=True
DATABASE_URL=postgresql://your_database_user:your_database_password@localhost:5432/your_database_name
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

  EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
  EMAIL_HOST=smtp.gmail.com
  EMAIL_PORT=587
  EMAIL_HOST_USER=your@gmail.com
  EMAIL_HOST_PASSWORD=your 'app password' from google account

# Cấu hình Trợ lý AI (Google Gemini - Khuyên dùng và Miễn phí)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
GEMINI_AI_MODEL=gemini-1.5-flash

# Cấu hình dự phòng (Cloudflare Workers AI hoặc Groq)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
GROQ_API_KEY=
GROQ_AI_MODEL=llama-3.3-70b-versatile